<style>
    .prop65 {
        max-width: 65ch;
        justify-self: center;
        margin-top: 32px;
        margin-bottom: 64px;

        h1 {
            text-align: center;
        }

        p {
            /* text-indent: 2em; */
            margin-top: 16px;
        }
    }

    .prop65-header {
        display: flex;
        justify-content: start;
        align-items: center;

        svg {
            width: 10%;
            height: auto;
        }
    }
</style>
