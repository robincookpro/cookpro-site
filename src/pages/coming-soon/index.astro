---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Under Construction">
    <div class="construction">
        <h1>Under Construction</h1>
        <p>Check back soon! We're currently working on this feature.</p>
    </div>
</BaseLayout>

<style>
    .construction {
        justify-self: center;
        margin-top: 64px;

        display: flex;
        flex-direction: column;
        align-items: center;
    }
</style>
