---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
    <div class="not-found">
        <h1>404</h1>
        <p>Page Not Found</p>
        <p>The requested URL could not be found</p>
    </div>
</BaseLayout>

<style>
    .not-found {
        justify-items: center;
        font-size: 2rem;
        margin-top: 64px;
    }
</style>
